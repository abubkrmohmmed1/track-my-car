# ==========================================
# استثناء الملفات الحساسة والصور والمستندات
# ==========================================

# مستندات وفصول البحث الأصلية والملفات المستخرجة
*.docx
*.doc
*.pdf
extracted_doc.txt

# الصور المرفوعة ومجلد الرفع (Uploads)
uploads/*
!uploads/.gitkeep

# صور واتساب والمخططات المرجعية الأولية
IMG-*.jpg
IMG-*.jpeg
IMG-*.png

# الجلسات والكاش وسجلات النظام
sessions/*
!sessions/.gitkeep
cache/*
!cache/.gitkeep
*.log

# قواعد البيانات المحلية التجريبية
database/*.sqlite
database/*.db

# ملفات النظام والمحررات
.vscode/
.idea/
Thumbs.db
.DS_Store
